# Copy this file to ".env" for local use. On Render, add these in Environment settings.

# Postgres connection string (from Neon or Supabase)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# From Google Cloud Console > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Any long random string (used to sign login cookies)
SESSION_SECRET=change-me-to-a-long-random-string

# Admin account. Only used the first time the server starts (creates the admin).
# After that, the password lives (hashed) in the database and is changed from the dashboard.

# Optional
ALLOWED_DOMAIN=@mitsgwl.ac.in
PORT=3000
